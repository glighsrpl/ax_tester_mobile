# LLM API keys
OPENAI_API_KEY=sk-...

# Browser executor: "local" or "mcp"
AXTESTER_EXECUTOR=local
BROWSER_EXECUTOR_URL=

# Capability selection: can be "any" or "personal"
#   "any" uses the shared browser-chrome capability,
#   "personal" requires CAPABILITY_ID and CAPABILITY_NAME below.
CAPABILITY_POLICY=any
CAPABILITY_ID=
CAPABILITY_NAME=

# Mobile executor
APPIUM_SERVER_URL=

ANDROID_HOME=
ANDROID_SDK_ROOT=
PATH=

MOBILE_DEVICE_SERIAL=
MOBILE_CAPABILITY_ID=
MOBILE_PLATFORM=
MOBILE_DEVICE_NAME=
MOBILE_PLATFORM_VERSION=
